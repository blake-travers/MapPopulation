# ---- Stage 1: GDAL binaries ----
FROM ghcr.io/lambgeo/lambda-gdal:3.8-python3.11 AS gdal

# ---- Stage 2: REAL Lambda runtime ----
FROM public.ecr.aws/lambda/python:3.11

# Copy GDAL shared libraries
COPY --from=gdal /usr/local /usr/local

# Install python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app
COPY app.py population_aggregator.py ./

CMD ["app.lambda_handler"]




#Build:      docker build -f Dockerfile -t gdal-lambda .
#Run (exits immediately):      docker run -p 9000:8080 gdal-lambda
#Check if worked:       docker ps -a